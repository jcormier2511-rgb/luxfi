# Postgres connection for the Fi backend (system of record; CSV is never authoritative)
DATABASE_URL=postgres://fi_app:fi_app_dev_pw@localhost:5432/fi_dev
TEST_DATABASE_URL=postgres://fi_app:fi_app_dev_pw@localhost:5432/fi_test

PORT=3000

# WatchFacts FS inventory sync
WATCHFACTS_API_BASE_URL=
WATCHFACTS_API_USERNAME=
WATCHFACTS_API_PASSWORD=
FS_SYNC_INTERVAL_MS=90000

# WTB sync stays disabled until the authenticated external WTB request is captured (spec section 13)
ENABLE_WTB_SYNC=false

# Extension reminder window before a monitor's expires_at (spec section 6.2)
MONITOR_EXTENSION_REMINDER_DAYS=3

# Admin routes (status, entitlement override) shared-secret auth for MVP
ADMIN_API_TOKEN=

# Messaging transport falls back to a stub (logs instead of sending) unless the
# WhatsApp Cloud API vars below are all set. See src/adapters/whatsapp.client.ts.
MESSAGING_PROVIDER=stub

# WhatsApp Cloud API (Meta direct). Get these from your Meta App's WhatsApp
# product page: WHATSAPP_ACCESS_TOKEN (a permanent System User token, not the
# 24h temporary one) and WHATSAPP_PHONE_NUMBER_ID from the app dashboard;
# WHATSAPP_APP_SECRET from App Settings > Basic; WHATSAPP_WEBHOOK_VERIFY_TOKEN
# is any string you choose and re-enter when registering the webhook URL
# (https://<your-host>/webhook/whatsapp) in the Meta dashboard.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_GRAPH_API_VERSION=v20.0

# Payment processor is intentionally NOT wired up for MVP. See src/adapters/payment.adapter.ts.
# Kept here only so the interface/env shape is preserved for a future integration.
PAYMENT_PROCESSOR=none

# Inbound message extraction falls back to the regex heuristic parser
# (messageParsing.service.ts) unless this is set. See src/adapters/aiExtraction.client.ts.
# A failed/unset key never blocks ingestion -- it just uses the heuristic instead.
ANTHROPIC_API_KEY=
ANTHROPIC_EXTRACTION_MODEL=claude-haiku-4-5-20251001
