# --- Whapi.Cloud (https://whapi.cloud) ---
# Create a channel in the Whapi dashboard, scan the burner number's QR code to link it,
# then copy the channel's API token here.
WHAPI_TOKEN=

# Public base URL of Whapi's REST endpoint. Leave as-is unless Whapi tells you otherwise.
WHAPI_BASE_URL=https://gate.whapi.cloud

# --- Telegram (optional, additional channel alongside WhatsApp) ---
# Bot token from @BotFather (/newbot). Leave blank to leave Telegram inactive.
TELEGRAM_BOT_TOKEN=
# Any string you choose — pass the same value as secret_token when calling
# `POST https://api.telegram.org/bot<token>/setWebhook` with
# url=<this deployment's public URL>/webhook/telegram. Telegram echoes it back on every
# webhook call, which is how /webhook/telegram authenticates inbound updates.
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_API_BASE_URL=https://api.telegram.org

# --- Twilio SMS/MMS (optional, additional channel alongside WhatsApp) ---
# From the Twilio console. Leave blank to leave SMS inactive.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The Twilio number messages are sent from.
TWILIO_FROM_NUMBER=
TWILIO_API_BASE_URL=https://api.twilio.com
# Only needed if this service sits behind a proxy/load balancer where req.protocol/host don't
# reflect the public URL configured as the number's webhook — required for Twilio's
# X-Twilio-Signature verification to pass.
TWILIO_WEBHOOK_BASE_URL=

# --- Server ---
PORT=3000
# Shared secret appended as ?token=... on the webhook URL you configure in Whapi,
# so random internet traffic can't POST fake messages into the bot.
WEBHOOK_TOKEN=change-me
# Meta WhatsApp Cloud API webhook verification token (chosen in the Meta dashboard) and
# app secret used to validate X-Hub-Signature-256 on incoming events.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# This deployment's own public URL (e.g. https://your-app.up.railway.app). Only needed to make
# POST /admin/upload/banner's response directly usable — see the Deploy section in README.md.
PUBLIC_BASE_URL=

# --- Outreach content ---
# Multi-line intro message sent to every Tier A/B contact when a blast kicks off.
# Use \n for line breaks if you set this via a real .env value on one line.
INTRO_MESSAGE="Hi {{name}} — this is Fi from LuxFi 👋\n\nWe monitor 900K+ WhatsApp/Telegram dealer listings (watches, handbags, jewelry) and match buyers with sellers automatically.\n\nWant to try it? Tell me up to 3 items you're looking to buy or sell, and I'll find you matches — free for your first 3 items."
# Publicly reachable image URL for the banner Whapi will attach to the intro message.
# (Whapi's /messages/image endpoint fetches media from a URL server-side; it can't take
# a local file path.)
BANNER_IMAGE_URL=

# WatchFacts membership signup (the $150/mo offer). Currently unused by the conversation
# flow — the Fi Conversation Flow Spec (v3) keeps "hiring Fi" ($50/mo) and WatchFacts
# membership deliberately separate. Kept configured for when the cross-system membership
# check (spec §4) exists.
MEMBERSHIP_URL=https://watchfacts.com/login

# --- Fi Conversation Flow (v3 spec) ---
# Sent once, the first time a contact replies. \n becomes a newline.
FI_INTRO_MESSAGE="Hi, I'm Fi — your personal luxury concierge.\nI'm here to help you:\n1. Find a buyer\n2. Find a seller\n3. Check pricing and market trends\n4. Check dealer reputation / references\n\nI'll automatically work on your first 3 matches so you can see what I can do."

# --- One-time old-Fi re-engagement (admin-triggered only) ---
FI_PUBLIC_PHONE_NUMBER=
# Approved WhatsApp business-initiated template. Variables, in order: complete greeting and number.
FI_RETURNING_TEMPLATE_NAME=fi_is_back
FI_RETURNING_TEMPLATE_LANGUAGE=en_US
FI_RETURNING_RATE_PER_HOUR=30

# --- Persistence ---
# Everything that needs to survive a restart/redeploy (conversation state, blast status,
# uploaded CSVs, uploaded banner) lives under this one directory — mount a single volume
# here in production. Defaults to ./persist for local dev (no volume needed).
PERSIST_DIR=./persist

# --- Data files ---
# Leave unset in production to use PERSIST_DIR/data/* (so the mounted volume is what
# persists). Set explicitly here for local dev convenience instead.
CONTACTS_CSV=./data/contacts.csv

# --- WatchFacts inventory database (Postgres, not a file) ---
# Required. WatchFacts Trading Floor listings (synced via the real API — see
# src/watchfacts/api.ts) live in a real Postgres database, not on this app's own volume, so
# they aren't tied to the container's lifecycle. Attach a Railway Postgres plugin to this
# service — Railway injects DATABASE_URL automatically once it's attached (see README's
# "Adding Postgres on Railway" section). For local dev, point this at any Postgres you have:
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/luxfi_dev
# How often the boot-time scheduler (src/index.ts) re-syncs the WatchFacts feed. Kept at 5
# rather than 1-2 minutes because each sync is a fresh login — the same category of risk as
# the WhatsApp number bans hit earlier in this project. No persistent session is reused
# across ticks yet (a possible future optimization).
INVENTORY_SYNC_INTERVAL_MINUTES=5
# WTB's auction_type value isn't confirmed against the real API yet (the toggle button that
# would reveal it isn't reliably clickable). Off by default: FS syncs and saves normally, WTB
# is reported as "disabled" (not as a recurring error) via /admin/inventory-status. Flip to
# true only once a real captured auction_type value is hardcoded in src/watchfacts/api.ts.
ENABLE_WTB_SYNC=false

# --- Personalized morning / afternoon market updates ---
# Off by default. Enable explicitly in Railway only after validating the Whapi channel.
ENABLE_MARKET_UPDATES=false
# Local wall-clock times in HH:MM (24-hour) format. IANA timezone rules handle DST.
MARKET_UPDATE_MORNING_TIME=09:00
MARKET_UPDATE_AFTERNOON_TIME=16:00
MARKET_UPDATE_TIMEZONE=America/New_York
# Recover a delivery missed during a short restart. Values are safety-capped at 60 minutes,
# so a morning digest is never sent many hours late. Set to 0 for exact-minute delivery only.
MARKET_UPDATE_GRACE_MINUTES=60
# False suppresses a digest when counts are unchanged and there are no new matches, as well
# as empty/no-activity digests. True permits those routine status updates.
MARKET_UPDATE_ALLOW_UNCHANGED=false
# Sentiment stays "insufficient" until this many total buyer + seller observations exist.
MARKET_UPDATE_MIN_OBSERVATIONS=3

# --- Trial limits ---
# Trial = N *approved* matches, not N searches — searching and passing are unlimited.
TRIAL_MAX_APPROVED_MATCHES=3
TRIAL_MAX_OPTIONS_PER_ITEM=5

# --- Outreach pacing & pilot sizing ---
# How many never-contacted Tier A/B contacts a single blast run will message.
OUTREACH_BATCH_LIMIT=50
# Messages per hour, spread evenly (5 = one every 12 min). Set to 0 to fall back to
# OUTREACH_DELAY_MS (flat ms delay) instead.
OUTREACH_RATE_PER_HOUR=5
OUTREACH_DELAY_MS=8000

# --- WatchFacts intro personalization (optional) ---
# When enabled, the blast logs into watchfacts.com once per run and, for each contact that
# has a wf_profile_id in contacts.csv, opens their intro with their own most recent listing
# (e.g. "Saw you just posted ..."). Requires Playwright's Chromium installed in whatever
# environment actually runs the blast: `npx playwright install chromium`.
# Validate with `npm run wf:test -- <profileId>` before trusting this in a real send —
# the scraper's selectors are best-effort and unverified against the live site.
# Whether confirming a WTB may notify real dealers.
#   unset   suppressed exactly when RESTRICT_OUTBOUND_TO is set (testing against production data)
#   true    always suppressed
#   false   never suppressed, even while restricted -- to exercise the outreach path deliberately
# Redirecting outbound is NOT enough on its own: it contains the message, but each candidate
# dealer's opportunity is still claimed permanently and their coverage counters still move.
SUPPRESS_DEALER_OUTREACH=

WATCHFACTS_ENABLED=false
WATCHFACTS_EMAIL=
WATCHFACTS_PASSWORD=
WATCHFACTS_LOGIN_URL=https://watchfacts.com/login
WATCHFACTS_LISTINGS_URL_TEMPLATE=https://watchfacts.com/profile-listings?profileId={id}&profileAccessType=id
# Only surface inventory posted (or, where no posted date is known, first seen) within this many
# days. 0 disables the window entirely. Applied to matching, market pulse, and dealer outreach.
WATCHFACTS_MAX_LISTING_AGE_DAYS=15
# Ceiling on rows one search may read when the request names no reference to narrow by. Well
# above the flash-sale pool on purpose; raise it only with the query plan in front of you.
WATCHFACTS_MAX_CANDIDATE_LISTINGS=5000
# Rows per multi-row INSERT during a sync.
WATCHFACTS_SYNC_BATCH_SIZE=500
# Pagination safety valve. Sized for a full catalogue; a sync that hits it logs that it truncated.
WATCHFACTS_MAX_SYNC_PAGES=40000
