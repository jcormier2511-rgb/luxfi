# --- GreenAPI (https://green-api.com) ---
# Create an instance in the GreenAPI console, scan the burner number's QR code to
# authorize it, then copy these two values from the instance dashboard.
GREEN_API_ID_INSTANCE=
GREEN_API_TOKEN_INSTANCE=

# Public base URL of GreenAPI's REST endpoint. Leave as-is unless GreenAPI tells you otherwise.
GREEN_API_BASE_URL=https://api.green-api.com

# --- Server ---
PORT=3000
# Shared secret appended as ?token=... on the webhook URL you configure in GreenAPI,
# so random internet traffic can't POST fake messages into the bot.
WEBHOOK_TOKEN=change-me

# --- Outreach content ---
# Multi-line intro message sent to every Tier A/B contact when a blast kicks off.
# Use \n for line breaks if you set this via a real .env value on one line.
INTRO_MESSAGE="Hi {{name}} — this is Fi from LuxFi 👋\n\nWe monitor 900K+ WhatsApp/Telegram dealer listings (watches, handbags, jewelry) and match buyers with sellers automatically.\n\nWant to try it? Tell me up to 3 items you're looking to buy or sell, and I'll find you matches — free for your first 3 items."
# Publicly reachable image URL for the banner GreenAPI will attach to the intro message.
# (GreenAPI's sendFileByUrl requires a URL it can fetch; it can't take a local file path.)
BANNER_IMAGE_URL=

# Link sent once a contact's trial (3 items x 5 match options) is exhausted.
MEMBERSHIP_URL=https://luxfi.ai/signup

# --- Data files ---
CONTACTS_CSV=./data/contacts.csv
INVENTORY_CSV=./data/wf_inventory.csv

# --- Trial limits ---
TRIAL_MAX_ITEMS=3
TRIAL_MAX_OPTIONS_PER_ITEM=5

# --- Outreach pacing & pilot sizing ---
# How many never-contacted Tier A/B contacts a single blast run will message.
OUTREACH_BATCH_LIMIT=50
# Messages per hour, spread evenly (5 = one every 12 min). Set to 0 to fall back to
# OUTREACH_DELAY_MS (flat ms delay) instead.
OUTREACH_RATE_PER_HOUR=5
OUTREACH_DELAY_MS=8000
