{
  "name": "luxfi-whatsapp-agent",
  "version": "0.1.0",
  "description": "WhatsApp outreach + matching agent for LuxFi Tier A/B dealer lists (Whapi.Cloud-based)",
  "private": true,
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "outreach": "ts-node-dev --transpile-only src/outreach/runBlast.ts",
    "wf:test": "ts-node-dev --transpile-only src/watchfacts/testFetch.ts",
    "wf:sync-inventory": "ts-node-dev --transpile-only src/watchfacts/syncInventory.ts",
    "test": "node --require ts-node/register --test src/watchfacts/api.test.ts src/watchfacts/inventoryDb.test.ts"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "csv-parse": "^5.5.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "playwright": "^1.62.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.9",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.3"
  }
}
