{
  "name": "luxfi-whatsapp-agent",
  "version": "0.1.0",
  "description": "WhatsApp outreach + matching agent for LuxFi Tier A/B dealer lists (GreenAPI-based)",
  "private": true,
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc -p tsconfig.json",
