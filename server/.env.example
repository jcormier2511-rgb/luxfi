PORT=3000

# Postgres connection string, e.g. postgresql://user:password@localhost:5432/luxfi
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/luxfi

# Green API (green-api.com) instance credentials.
# Create an instance at https://console.green-api.com, scan the QR code with
# the WhatsApp number you want Fi to run as, then copy these two values.
GREEN_API_ID_INSTANCE=
GREEN_API_API_TOKEN_INSTANCE=
GREEN_API_BASE_URL=https://api.green-api.com

# Optional shared secret. If set, incoming webhooks must include
# ?token=<value> or they're rejected with 401. Configure the same value as
# the query param on the webhook URL you register with Green API.
WEBHOOK_TOKEN=

CREDITS_PER_MATCH=15
FREE_MATCHES_PER_DEALER=3

# Fi's "brain". Claude reads every group message to decide whether it's a
# listing (and extracts it), and drives DM conversations end to end —
# checking reviews, requesting vouches, or just replying naturally.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5

# Mounts POST /simulate/message for local testing without live WhatsApp
# credentials. Never enable in production.
ENABLE_DEV_SIMULATE=false
